<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApplication1.ViewModels"
        x:Class="AvaloniaApplication1.Views.EditSensorWindow"
        x:DataType="vm:EditSensorViewModel"
        Title="Налаштування датчика"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Spacing="12" Margin="20">

        <StackPanel Spacing="2">
            <TextBlock Text="Назва датчика" FontSize="12" Opacity="0.7" />
            <TextBlock Text="{Binding Tag}" FontWeight="SemiBold" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,4,0">
                <TextBlock Text="Unit (slave ID)" FontSize="12" Opacity="0.7" />
                <NumericUpDown Value="{Binding UnitId}" Minimum="0" Maximum="247" FormatString="0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2" Margin="4,0,0,0">
                <TextBlock Text="Адреса регістра" FontSize="12" Opacity="0.7" />
                <NumericUpDown Value="{Binding Address}" Minimum="0" Maximum="65535" FormatString="0" />
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,4,0">
                <TextBlock Text="Функція" FontSize="12" Opacity="0.7" />
                <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding Area}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2" Margin="4,0,0,0">
                <TextBlock Text="Тип даних" FontSize="12" Opacity="0.7" />
                <ComboBox ItemsSource="{Binding DataTypes}" SelectedItem="{Binding DataType}"
                          IsEnabled="{Binding IsDataTypeEditable}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="IndianRed" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Скасувати" Command="{Binding CancelCommand}" />
            <Button Content="Зберегти" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>