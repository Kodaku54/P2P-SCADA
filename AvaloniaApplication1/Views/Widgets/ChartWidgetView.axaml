<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels"
             xmlns:widgets="clr-namespace:AvaloniaApplication1.ViewModels.Widgets"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication1.Views.Widgets.ChartWidgetView"
             x:DataType="widgets:ChartWidgetViewModel">
    <Grid Background="#2B2A4A" Width="{Binding Width}" Height="{Binding Height}">
        
        <lvc:CartesianChart Series="{Binding Series}" Padding="2"  CornerRadius="30"/>
    </Grid>
</UserControl>
