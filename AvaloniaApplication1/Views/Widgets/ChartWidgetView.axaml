<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vm="clr-namespace:AvaloniaApplication1.ViewModels"
             xmlns:widgets="clr-namespace:AvaloniaApplication1.ViewModels.Widgets"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication1.Views.Widgets.ChartWidgetView"
             x:DataType="widgets:ChartWidgetViewModel"
             Classes.stale="{Binding IsStale}">
    <Grid Background="#2B2A4A" Width="{Binding Width}" Height="{Binding Height}"
          RowDefinitions="Auto,*"
          ToolTip.Tip="{Binding StatusText}"
          ToolTip.Placement="Pointer"
          ToolTip.HorizontalOffset="12"
          ToolTip.VerticalOffset="18">

        <TextBlock Text="{Binding Title}"
                   FontSize="14" Foreground="#E0E0E0"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0" />

        <lvc:CartesianChart Background="#2B2A4A" ZoomMode="X" Grid.Row="1" Series="{Binding Series}" Padding="2" CornerRadius="10" />
        <Border Grid.RowSpan="2" BorderBrush="{Binding StatusBrush}" BorderThickness="2"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>
