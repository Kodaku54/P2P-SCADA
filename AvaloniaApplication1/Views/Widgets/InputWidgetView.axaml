<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="clr-namespace:AvaloniaApplication1.ViewModels.Widgets"
             x:Class="AvaloniaApplication1.Views.Widgets.InputWidgetView"
             x:DataType="widgets:InputWidgetViewModel"
             Classes.stale="{Binding IsStale}">

    <!-- Розмір віджета задає користувач; вміст розтягується під нього -->
    <Panel Width="{Binding Width}" Height="{Binding Height}"
           ToolTip.Tip="{Binding StatusText}"
           ToolTip.Placement="Pointer"
           ToolTip.HorizontalOffset="12"
           ToolTip.VerticalOffset="18">

        <ToolTip.IsOpen>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsPointerOver" RelativeSource="{RelativeSource Self}" />
                <Binding Path="StatusText" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
            </MultiBinding>
        </ToolTip.IsOpen>

        <!-- Датчик Bool: кнопка на всю картку -->
        <Border IsVisible="{Binding IsButton}"
                Background="#2B2A4A" CornerRadius="10" Padding="12" ClipToBounds="True"
                BorderBrush="{Binding StatusBrush}" BorderThickness="2">
            <Button Content="{Binding Title}" Command="{Binding ApplyCommand}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    FontSize="18" />
        </Border>

        <!-- Числові датчики: поле вводу розтягується по ширині -->
        <Border IsVisible="{Binding IsNumeric}"
                Background="#2B2A4A" CornerRadius="10" Padding="12" ClipToBounds="True"
                BorderBrush="{Binding StatusBrush}" BorderThickness="2">
            <StackPanel Spacing="8" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentText}"
                               FontSize="14" Foreground="#9FA8DA" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding Title}" FontSize="14" Foreground="#E0E0E0"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding InputText}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Записати" Command="{Binding ApplyCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>